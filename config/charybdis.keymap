#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors/bat_print.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// #7 zmk-helpers: 매크로(ZMK_HOLD_TAP / ZMK_COMBO) + 커스텀 키 위치 라벨.
// COMBO_TERM 은 helper.h include "이전"에 정의해야 기본값(30) 대신 60 이 적용됨.
#define COMBO_TERM 60
#include <zmk-helpers/helper.h>
#include "charybdis_keypos.h"   // KEYS_L / KEYS_R / THUMBS 등 (구 LEFT_KEYS 등 대체)

#define BASE  0
#define SYM   1
#define NAV   2
#define POI   3
#define FUN   4
#define NUM   5
#define CNT   6
#define SCR   7
#define SNI   8
#define TBALL 9
#define TUR   10

&sl {
    release-after-ms = <250>;
};

&mt {
    tapping-term-ms = <200>;
    require-prior-idle-ms = <150>;
};

// 콤보 — ZMK_COMBO_3(name, bindings, keypos): 전 레이어 동작, timeout = COMBO_TERM(60).
// 위치는 키 라벨로 표기(구 숫자와 동일: 21 22 == LB3 LB2 등).
ZMK_COMBO(copy,       &kp LG(C), LB3 LB2)
ZMK_COMBO(paste,      &kp LG(V), LB2 LB1)
ZMK_COMBO(undo,       &kp LG(Z), LB4 LB3)
ZMK_COMBO(f18,        &kp F18,   RB2 RB3)
ZMK_COMBO(poi_toggle, &tog POI,  RB1 RB2)
// 배터리: T+Y(LT0 RT0) 동시 → "L<좌> R<우>" 타이핑. base 레이어 + 150ms idle(타이핑 중 오발 방지).
ZMK_COMBO(battery,    &bat_print, LT0 RT0, BASE, 50, 150)

// 엄지 레이어탭 (hold=레이어, tap=키). 타이밍/동작 동일, 위치 그룹만 라벨로.
ZMK_HOLD_TAP(tll,
    flavor = "balanced";
    tapping-term-ms = <160>;
    quick-tap-ms = <160>;
    require-prior-idle-ms = <100>;
    bindings = <&mo>, <&kp>;
    hold-trigger-key-positions = <KEYS_L KEYS_R THUMBS_R>;
    hold-trigger-on-release;
)
ZMK_HOLD_TAP(tlr,
    flavor = "balanced";
    tapping-term-ms = <160>;
    quick-tap-ms = <160>;
    require-prior-idle-ms = <100>;
    bindings = <&mo>, <&kp>;
    hold-trigger-key-positions = <KEYS_L KEYS_R THUMBS_L>;
    hold-trigger-on-release;
)

// 홈로우 모드 (timeless 값 #3 유지). positional + hold-trigger-on-release.
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <120>;
    quick-tap-ms = <160>;
    require-prior-idle-ms = <100>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <120>;
    quick-tap-ms = <160>;
    require-prior-idle-ms = <100>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
              &kp Q         &kp W         &kp E          &kp R           &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P
              &hml LCTRL A  &hml LALT S   &hml LSHFT D   &hml LGUI F     &kp G            &kp H         &hmr RGUI J   &hmr RSHFT K  &hmr RALT L   &hmr RCTRL SEMI
              &kp Z         &kp X         &kp C          &kp V           &kp B            &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH
                                          &tll SYM ESC   &tll NAV SPACE  &tll POI TAB     &tlr FUN RET  &tlr NUM BSPC
            >;
        };

        Symbol {
            label = "Symbol";
            bindings = <
              &trans            &kp AMPS         &kp ASTRK         &kp UNDER        &kp MINUS            &kp GRAVE     &kp LBKT          &kp RBKT          &kp BSLH         &trans
              &kp LCTRL         &hml LALT DLLR   &hml LSHFT PRCNT  &hml LGUI CARET  &kp PLUS             &kp SQT       &hmr RGUI LBRC    &hmr RSHFT RBRC   &hmr RALT PIPE   &kp RCTRL
              &trans            &kp EXCL         &kp AT            &kp HASH         &kp EQUAL            &kp DQT       &kp LPAR          &kp RPAR          &kp TILDE        &trans
                                                 &trans            &trans           &trans               &trans        &trans
            >;
        };

        Navigation {
            label = "Navigation";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &trans        &kp END        &kp HOME      &trans        &kp PAUSE_BREAK
              &kp LCTRL     &kp LALT      &kp LSHFT      &kp LGUI        &trans           &kp LEFT      &kp DOWN       &kp UP        &kp RIGHT     &trans
              &trans        &trans        &trans         &mo CNT         &trans           &trans        &kp PAGE_DOWN  &kp PAGE_UP   &trans        &kp INS
                                          &trans         &trans          &trans           &kp CAPS      &kp DEL
            >;
        };

        Pointer {
            label = "Pointer";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &kp LCTRL     &kp LALT      &kp LSHFT      &kp LGUI        &trans           &trans        &trans         &mo  SNI      &mo TUR       &trans
              &trans        &mo TUR       &mo SNI        &mo SCR         &trans           &trans        &mkp MB1       &mkp MB2      &mkp MB3      &mo SCR
                                          &trans         &trans          &trans           &mkp MB4      &mkp MB5
            >;
        };

        Function {
            label = "Function";
            bindings = <
              &trans        &kp F7        &kp F8         &kp F9          &kp F10          &trans        &trans         &trans        &trans        &trans
              &trans        &kp F4        &kp F5         &kp F6          &kp F11          &trans        &kp RGUI       &kp RSHFT     &kp RALT      &kp RCTRL
              &trans        &kp F1        &kp F2         &kp F3          &kp F12          &trans        &trans         &trans        &trans        &trans
                                          &trans         &trans          &trans           &trans        &trans
            >;
        };

        Number {
            label = "Number";
            bindings = <
              &trans        &kp N7        &kp N8         &kp N9          &kp N0           &trans        &trans         &trans        &trans        &trans
              &trans        &kp N4        &kp N5         &kp N6          &trans           &trans        &kp RGUI       &kp RSHFT     &kp RALT      &kp RCTRL
              &trans        &kp N1        &kp N2         &kp N3          &trans           &trans        &trans         &trans        &trans        &trans
                                          &trans         &trans          &trans           &trans        &trans
            >;
        };

        Control {
            label = "Control";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &out OUT_TOG    &out OUT_BLE   &out OUT_USB   &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &kp C_MUTE      &kp C_VOL_DN   &kp C_VOL_UP   &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &bt BT_CLR_ALL  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3
                                          &trans         &trans          &trans           &trans          &trans
            >;
        };

        Scroll {
            label = "Scroll";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
                                          &trans         &trans          &trans           &trans        &trans
            >;
        };

        Sniper {
            label = "Sniper";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
                                          &trans         &trans          &trans           &trans        &trans
            >;
        };

        // 트랙볼 움직임으로만 자동 활성화되는 레이어 (Pointer와 동일 바인딩)
        // POI(3)와 분리해야 ZMK layer state 비트마스크 충돌 방지 — 엄지 POI hold 중 트랙볼 움직여도 layer drop 안 됨
        Trackball {
            label = "Trackball";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &kp LCTRL     &kp LALT      &kp LSHFT      &kp LGUI        &trans           &trans        &trans         &mo  SNI      &mo TUR       &trans
              &trans        &mo TUR       &mo SNI        &mo SCR         &trans           &trans        &mkp MB1       &mkp MB2      &mkp MB3      &mo SCR
                                          &trans         &trans          &trans           &mkp MB4      &mkp MB5
            >;
        };

        Turbo {
            label = "Turbo";
            bindings = <
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
              &trans        &trans        &trans         &trans          &trans           &trans        &trans         &trans        &trans        &trans
                                          &trans         &trans          &trans           &trans        &trans
            >;
        };
    };
};
